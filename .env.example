# ─────────────────────────────────────────────────────────────────────────────
# Get Shortlisted — environment variables
# Copy to .env.local for development. Set the same names in Vercel for deploys.
# Nothing here is required to run locally: every variable has a safe default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage (not used in this build) ─────────────────────────────────────────
# This build has no database and no blob storage: the phrase index is a JSON
# file in data/index, and submissions/waitlist/scans live in server memory
# (reset on restart). These are kept so the names are reserved if you add
# Neon Postgres / Vercel Blob / Upstash later.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email ────────────────────────────────────────────────────────────────────
# Resend API key for the submission confirmation (with the deletion link) and
# purchase receipts. Optional: without it no email is sent, and the deletion
# link is still shown on screen after submitting.
# The sending domain in src/config.ts (SITE.emailFrom) must be verified in Resend.
RESEND_API_KEY=

# ── Admin ────────────────────────────────────────────────────────────────────
# Single shared password for /admin. Required in production (the panel is
# disabled without it). In development it defaults to "admin".
ADMIN_PASSWORD=

# ── Signing ──────────────────────────────────────────────────────────────────
# Secret for HMAC-signed cookies and share links. Required in production —
# any long random string, e.g. `openssl rand -hex 32`. Changing it signs
# everyone out and invalidates existing share links.
SIGNING_SECRET=

# ── Payments (v2, only used when NEXT_PUBLIC_PAID_ENABLED=true) ─────────────
# Razorpay Dashboard → Account & Settings → API Keys.
# Development without keys uses a simulated checkout (never in production).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Webhooks → add https://<your-domain>/api/pay/webhook
# with events order.paid and payment.failed, and paste the secret here.
RAZORPAY_WEBHOOK_SECRET=

# ── Site ─────────────────────────────────────────────────────────────────────
# Public base URL, used in emails and link previews. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://getshortlisted.in

# Paid features (Library, Compare, checkout). "true" turns them on; anything
# else keeps them 404. NEXT_PUBLIC_ vars are inlined at build time, so
# redeploy after changing it.
NEXT_PUBLIC_PAID_ENABLED=false
